<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动第一帧的 windowBackground：与 App 内页面同一套「右上蓝、左下青」
     双辉光 + 深空蓝渐进，中间压一枚圆角品牌图块。
     Android 在 Activity 真正画出来之前就能显示它，Python 解释器启动那
     几百毫秒不会是一片空白；MainActivity 随后盖上的动画层用同一组色值。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="285"
                android:startColor="#070B12"
                android:centerColor="#0C1624"
                android:endColor="#0A101B"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.78"
                android:centerY="0.14"
                android:gradientRadius="78%p"
                android:startColor="#3D3B82F6"
                android:endColor="#003B82F6"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.10"
                android:centerY="0.86"
                android:gradientRadius="66%p"
                android:startColor="#2622D3EE"
                android:endColor="#0022D3EE"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="116dp" android:height="116dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <solid android:color="#E60F1B2A"/>
            <stroke android:width="1dp" android:color="#6660A5FA"/>
        </shape>
    </item>
    <item android:gravity="center" android:width="100dp" android:height="100dp"
        android:drawable="@drawable/ic_brand_mark"/>
</layer-list>
