<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌角标底座：深空蓝渐进 + 一道蓝色描边，配 ic_brand_mark 一起用。
     顶栏、开屏、以及弹窗里所有「小角标」都只认这一个 drawable。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="11dp"/>
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1B3352"
        android:centerColor="#122238"
        android:endColor="#091320"/>
    <stroke
        android:width="1dp"
        android:color="#5C60A5FA"/>
    <padding
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp"/>
</shape>
