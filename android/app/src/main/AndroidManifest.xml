<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 系统日历提醒：把「该订了」和已确定的行程写成日历事件，由系统日历
         负责到点通知。两个都是危险权限，用户点「日历提醒」时才申请。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 回放生成要跑几十秒到几分钟，切到后台会被系统冻结（cached 进程），
         渲染线程跟着停。用前台服务把进程钉在 foreground 优先级。
         Android 14 起前台服务还要按类型声明 dataSync。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知要运行时授权；没授权时前台服务照常跑，只是通知栏
         看不到进度。这里只声明，不主动弹权限框打断生成。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：下载完自己拉起系统安装器。Android 8+ 要求显式声明，
         且用户还得在「安装未知应用」里给本 App 授权（系统会引导）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 直接唤起高德地图 App：Android 11+ 包可见性。不声明的话
         resolveActivity 即使装了高德也返回 null，会被误判成「没装」而走网页。 -->
    <queries>
        <package android:name="com.autonavi.minimap" />
    </queries>

    <application
        android:name=".RCApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HuaweiLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CorosLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 用 RunnerCoach 打开 GPX：文件管理器 / 浏览器「其他应用打开」。
                 MIME 与扩展名各写一组：Android 的 <data> 在同一条里是「与」，
                 跨条是「或」。很多文件管理器把 .gpx 报成 octet-stream，
                 所以除 gpx+xml 外还要用 pathPattern 兜住扩展名。 -->
            <intent-filter android:label="导入赛道 GPX">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/gpx+xml" />
                <data android:scheme="file" android:mimeType="application/gpx+xml" />
                <data android:scheme="content" android:mimeType="application/xml"
                    android:pathPattern=".*\\.gpx" />
                <data android:scheme="content" android:mimeType="text/xml"
                    android:pathPattern=".*\\.gpx" />
                <data android:scheme="content" android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.gpx" />
                <data android:scheme="content" android:host="*"
                    android:pathPattern=".*\\.gpx" />
                <data android:scheme="file" android:host="*"
                    android:pathPattern=".*\\.gpx" />
            </intent-filter>

            <!-- 微信 / QQ / 浏览器「分享到 RunnerCoach」。
                 这里只收 gpx 专用 MIME：octet-stream 会让 App 出现在所有
                 文件的分享菜单里（分享照片也弹出跑步 App 很荒谬），
                 那些来源走上面的 VIEW 路径更准确。 -->
            <intent-filter android:label="导入赛道 GPX">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
            </intent-filter>
        </activity>
        <service
            android:name=".MotionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- 安装包出口：file:// 不能交给外部（FileUriExposed），
             更新包下载完从这里以 content:// 交给系统安装器。 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".TodayWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_card_info" />
        </receiver>
    </application>
</manifest>
