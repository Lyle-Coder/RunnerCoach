# 网关环境变量（复制为 .env 或直接 export）
# 上游模型商（deepseek-flash = V4.1-Flash，原生多模态支持读图；价格表见 app.py）
UPSTREAM_BASE=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-你的DeepSeekKey
UPSTREAM_MODEL=deepseek-flash

# 管理接口令牌（必填！生成：python -c "import secrets;print(secrets.token_urlsafe(24))"）
ADMIN_TOKEN=

# 计费
MARGIN=1.15            # 平台加价倍率
FREE_GRANT=500000      # 新用户赠送额度，单位微元（500000 = 0.5 元）
DB_PATH=/app/data/data.db

# 邮箱验证码（推荐，零成本：QQ 邮箱设置→账户→开启 SMTP→生成授权码）
# 配好后用户可以用邮箱 + 验证码登录；不配则邮箱进入开发模式（验证码回显，仅内测）
SMTP_HOST=smtp.qq.com   # QQ: smtp.qq.com / 163: smtp.163.com / Gmail: smtp.gmail.com
SMTP_PORT=465           # 465=SSL（推荐） / 587=STARTTLS
SMTP_USER=你的发件邮箱@qq.com
SMTP_PASS=你的SMTP授权码   # 注意是授权码，不是邮箱登录密码
SMTP_FROM=              # 必须是发件邮箱地址（如 xxx@qq.com），不是显示名；留空默认同 SMTP_USER

# 短信验证码（可选：按条计费，仅当必须支持手机号注册时才开）
# dev    = 开发模式：验证码打印到日志并回显给客户端，仅限内测！
# aliyun = 阿里云短信（开通 dysmsapi，签名+模板审核通过后填入）
SMS_PROVIDER=dev
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 在线支付（可选，未配置时用户只能用兑换码充值）
# ''              = 关闭（/v1/orders 返回 503）
# demo            = 测试通道：下单成功后用 admin/orders/pay 模拟到账，联调用
# wechat_native   = 微信 Native 支付（需商户号；回调验证需容器内有 cryptography）
PAY_PROVIDER=
WXPAY_MCHID=             # 商户号
WXPAY_APPID=             # 绑定的公众号/开放平台 appid
WXPAY_APIV3_KEY=         # APIv3 密钥（商户平台→账户中心→API安全，32 位）
WXPAY_CERT_SERIAL=       # 商户 API 证书序列号（同上位置下载证书后可查）
WXPAY_PRIVATE_KEY_PATH=  # apiclient_key.pem 在容器内的路径（建议挂载到 /app/cert/）
WXPAY_NOTIFY_URL=        # 回调地址，必须 https，如 https://你的域名/v1/wechat/notify
ORDER_EXPIRE=1800        # 订单有效期（秒），超时未付自动过期

# 客户端平台入口（App 零配置的关键）
# App 出厂内置了一个引导地址，但会定期来问 GET /v1/client/config「现在该连哪」。
# 换域名、轮换分享码只改这两个值并重启容器，不必重新发版；
# 留空则 App 继续用内置的引导地址。
# RC_PUBLIC_BASE 必须是不带 ?sharecode= 的 https 根地址；
# RC_SHARE_CODE 是发布分享链接里的 sharecode（访问凭证，不是密钥）。
RC_PUBLIC_BASE=
RC_SHARE_CODE=
