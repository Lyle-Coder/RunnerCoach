# 网关环境变量（复制为 .env 或直接 export）
# 上游模型商（deepseek-flash = V4.1-Flash，原生多模态支持读图；价格表见 app.py）
UPSTREAM_BASE=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-你的DeepSeekKey
UPSTREAM_MODEL=deepseek-flash

# 管理接口令牌（必填！生成：python -c "import secrets;print(secrets.token_urlsafe(24))"）
ADMIN_TOKEN=

# 计费
MARGIN=1.15            # 平台加价倍率
FREE_GRANT=2000000     # 新用户赠送额度，单位微元（2000000 = 2 元）
DB_PATH=/app/data/data.db

# 邮箱验证码（推荐，零成本：QQ 邮箱设置→账户→开启 SMTP→生成授权码）
# 配好后用户可以用邮箱 + 验证码登录；不配则邮箱进入开发模式（验证码回显，仅内测）
SMTP_HOST=smtp.qq.com   # QQ: smtp.qq.com / 163: smtp.163.com / Gmail: smtp.gmail.com
SMTP_PORT=465           # 465=SSL（推荐） / 587=STARTTLS
SMTP_USER=你的发件邮箱@qq.com
SMTP_PASS=你的SMTP授权码   # 注意是授权码，不是邮箱登录密码
SMTP_FROM=              # 显示的发件人，留空默认同 SMTP_USER

# 短信验证码（可选：按条计费，仅当必须支持手机号注册时才开）
# dev    = 开发模式：验证码打印到日志并回显给客户端，仅限内测！
# aliyun = 阿里云短信（开通 dysmsapi，签名+模板审核通过后填入）
SMS_PROVIDER=dev
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
