# /etc/caddy/Caddyfile
#
# 备案通过后启用：
#   1. 把 site/landing/ 同步到 /var/www/runnercoach
#   2. sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
#   3. sudo caddy validate --config /etc/caddy/Caddyfile
#   4. sudo systemctl reload caddy
#
# 源站 8443 是自签证书，反代时必须跳过校验；APK 走 8088 明文只读端口。

runnercoach.cn {
	encode gzip

	# 后台/接口：登录、同步、组、管理页都走 8443
	@api path /v1/* /manage /manage/* /w /w/* /health /app /app/*
	handle @api {
		reverse_proxy https://127.0.0.1:8443 {
			transport http {
				tls_insecure_skip_verify
			}
			header_up X-Forwarded-Proto https
		}
	}

	# 安装包：只读，走 8088
	handle /apk/* {
		reverse_proxy http://127.0.0.1:8088
	}

	# 其余全部是静态介绍页（备案时看到的“网站”）
	handle {
		root * /var/www/runnercoach
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
