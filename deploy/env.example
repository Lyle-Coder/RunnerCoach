# RunnerCoach 服务端环境变量（无域名部署）
#
# 放到 /etc/runnercoach/env，权限 600，属主 root。
# 改完记得 systemctl restart runnercoach。
#
# 这份文件里全是密钥，**不进仓库**（.gitignore 已排除 deploy/env）。

# ── 必填 ────────────────────────────────────────────────────────────────
# 管理令牌。生成：python3 -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# 上游模型（App 走你的网关调用，所以手机端不接触这个 Key）
UPSTREAM_BASE=https://api.deepseek.com/v1
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-flash

# ── 登录通道：必须配一个，否则服务会拒绝启动 ───────────────────────────
# 原因：短信走 dev、或邮箱没配 SMTP 时，验证码会明文回显给客户端，
# 等于任何人都能登录任意账号。这是硬护栏，不是提醒。
#
# 推荐邮箱：QQ 邮箱 → 设置 → 账户 → 开启 SMTP → 生成授权码（免费）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 短信（可选，按条计费；只有必须支持手机号注册时才开）
SMS_PROVIDER=dev
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ── 无域名 + HTTPS ──────────────────────────────────────────────────────
# 证书由 deploy/gen-cert.sh 生成，路径写这里。两个都填才起 TLS。
RC_TLS_CERT=/opt/runnercoach/certs/cert.pem
RC_TLS_KEY=/opt/runnercoach/certs/key.pem

# 只监听需要的地址；8443 是因为大陆服务器未备案的 80/443 容易被拦
BIND_HOST=0.0.0.0
PORT=8443

# ── 额度与计费 ──────────────────────────────────────────────────────────
# 新号自动注册送 0.5 元，公网开放注册时可被批量刷。内测期建议 0，
# 或者用兑换码发额（/admin/codes）。填 0 就是"注册能用、但调模型要自己充"。
FREE_GRANT=0
MARGIN=1.15

# ── 数据 ────────────────────────────────────────────────────────────────
DB_PATH=/opt/runnercoach/data/data.db

# 每日看板静态目录（可选，没有就 404，不影响其它功能）
RC_SITE_DIR=/opt/runnercoach/site

# ── 下发给客户端的业务地址 ──────────────────────────────────────────────
# 没有域名就填 https://<IP>:8443；留空则客户端用出厂内置值（build 时烧进去的）
RC_PUBLIC_BASE=
RC_SHARE_CODE=
